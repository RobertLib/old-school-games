# Database connection string (PostgreSQL)
#
# This URL names only the database. node-postgres fills in the host, user
# and password from PGHOST / PGUSER / PGPASSWORD or its own defaults:
# localhost over TCP, the current OS user, and no password. It does not use
# libpq's default Unix socket, so `createdb` can succeed over a socket while
# the app fails to authenticate over TCP. Supply TCP credentials below, or
# set PGHOST to the server's socket directory for peer authentication.
#
# A direct connection or a *session-mode* pooler (Supabase: port 5432). The
# app sets a per-connection statement_timeout at connect time, the migration
# runner relies on a session-level advisory lock and "SET statement_timeout",
# and pgbouncer-style transaction-mode poolers (Supabase: port 6543) neither
# accept startup parameters nor keep a session pinned to one backend.
DATABASE_URL=postgresql:///old_school_games
# Unix socket example; use the directory configured by your Postgres server:
# PGHOST=/var/run/postgresql
# Equivalently: DATABASE_URL=postgresql:///old_school_games?host=/var/run/postgresql
# A Postgres that wants to be reached over TCP with credentials — a container,
# a managed instance, production — is named in full instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/old_school_games

# Express session secret — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret

# Application environment: development | production | test
NODE_ENV=development

# Port the server listens on (optional, defaults to 3000)
PORT=3000

# Quietest level still written: error | warn | info (optional, default info)
#
# The access log writes one "info" line per request, so "warn" is how you keep
# an incident's error lines from being buried in ordinary traffic. It changes
# what is written, not where — that is NODE_ENV's job (production: stdout and
# stderr; development: combined.log and error.log; test: nothing).
#
# An unrecognised value warns once and falls back to info rather than being
# read as "off": a typo here would otherwise silence the log, and missing
# lines are the last thing anybody connects to a misspelled variable.
# LOG_LEVEL=info

# Host every production request is redirected to (optional)
CANONICAL_HOST=oldschoolgames.eu

# Origin serving game artwork and js-dos bundles (optional).
# Named in the Content-Security-Policy, so a fork pointing at its own storage
# bucket must set this or the browser will refuse every image and bundle.
# The player refuses a bundle from any other origin too, and it is a static
# file with no access to this variable — so change the MEDIA_ORIGIN constant
# in public/js/js-dos-player.js along with it. The suite checks the two agree.
MEDIA_ORIGIN=https://trwglibsccninuamefls.supabase.co

# Origin the DOS player is served from, when it is not this site (optional).
# Production sets this explicitly in fly.toml; leave it unset for localhost.
# Unset — the default — keeps the player at /js-dos.html on this origin,
# exactly as before. Set, game pages frame <PLAYER_ORIGIN>/js-dos.html, which
# is what turns the frame's sandbox from a formality into a boundary, and a
# request addressed to that host gets the player's own files and a 404 for
# everything else. A bare https:// origin in production and never
# CANONICAL_HOST itself: the app refuses to boot on either mistake. The
# player's frame-ancestors names https://<CANONICAL_HOST>, so a development
# server on localhost cannot frame one. Switching moves js-dos's saved games
# with it — read "The player origin" in README.md first.
# PLAYER_ORIGIN=https://old-school-games.fly.dev

# Media backups run outside the app, via scripts/backup-media.sh or the
# Media backup GitHub workflow. Credentials go in a private rclone config,
# not in the remote names. Local use: export these before npm run backup:media.
# MEDIA_BACKUP_SOURCE=media-source:game-bucket
# MEDIA_BACKUP_DESTINATION=media-backup:independent-bucket/old-school-games
# RCLONE_CONFIG=/absolute/path/to/private/rclone.conf

# Read by "npm run create-admin" only, never by the app. There is no sign-up
# route, so this is how the admin interface becomes reachable on a fresh
# install. Prefer passing them on the command that runs the script rather than
# leaving them here — the account lives in the database once it has run.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-long-random-password

# Database the test suite runs against (optional). Left unset it defaults to
# postgresql:///old_school_games_test — the database name alone. node-postgres
# uses the same PG* variables and defaults as above, including localhost over
# TCP unless PGHOST names a socket directory.
#
# Not here, though: `npm test` does not read this file (only the dev, start,
# migrate and create-admin scripts pass --env-file), so a value left in .env
# is silently ignored and the suite runs against the default. Export it in
# your shell, or put it in front of the command:
#
#   TEST_DATABASE_URL=postgresql://user:password@localhost:5432/old_school_games_test npm test
#   PGHOST=/var/run/postgresql npm test
