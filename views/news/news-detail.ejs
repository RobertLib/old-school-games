<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../head') %>
  <meta name="description" content="<%= description %>" />
  <title><%= title %></title>
  <%# Open Graph %>
  <meta property="og:title" content="<%= newsItem.title %>" />
  <meta property="og:description" content="<%= description %>" />
  <meta property="og:url" content="<%= canonicalUrl %>" />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="<%= siteName %>" />
  <%- include('../og-image') %>
  <meta property="article:published_time" content="<%= datePublished %>" />
  <meta property="article:modified_time" content="<%= dateModified %>" />
  <meta property="article:section" content="Retro Gaming" />
  <%
    // Only on a page that asks to be indexed. views/head.ejs already gates the
    // robots tag, the canonical and the breadcrumb schema on this one answer;
    // a node describing the page in detail belongs on the same side of it.
    // Nothing here was ever wrong — it was sent to consumers that had just
    // been told the page is not for them. See utils/indexability.ts.
  %>
  <% if (!isNoindex(req, locals)) { %>
  <script type="application/ld+json"><%- JSON.stringify(ldJson).replace(/</g, "\\u003c") %></script>
  <% } %>
</head>

<body class="layout">
  <%- include('../navbar') %>
  <%- include('../left-sidebar') %>
  <main id="main" tabindex="-1">
    <div class="container">
      <%- include('../flash') %>
      <section>
        <%- include('../breadcrumb') %>
        <article>
          <h1 class="text-xl" style="margin: 0 0 8px;"><%= newsItem.title %></h1>
          <div class="news-meta" style="margin-bottom: 20px;">
            <time datetime="<%= new Date(newsItem.createdAt).toISOString() %>">
              <%= new Date(newsItem.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </time>
          </div>
          <div class="news-content"><%- newsItem.content %></div>
        </article>
        <div style="margin-top: 24px; display: flex; gap: 8px; align-items: center;">
          <a href="/news" class="btn btn-outline">&larr; Back to News</a>
          <% if (req.session?.user?.role === 'ADMIN') { %>
          <a href="/news/<%= newsItem.id %>/edit" class="btn btn-outline">Edit</a>
          <% } %>
        </div>
      </section>
    </div>
  </main>
  <%- include('../right-sidebar') %>
  <%- include('../footer') %>
</body>

</html>
