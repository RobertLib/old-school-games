<div class="game-filters">
  <h2 class="text-lg" style="margin: 0">
    <% if (locals.letter) { %>
    Games starting with '<%= letter.toUpperCase() %>'
    <% } else if (locals.genre) { %>
    Games in the "<%= genre %>" genre
    <% } else if (locals.developer) { %>
    Games by developer "<%= developer %>"
    <% } else if (locals.publisher) { %>
    Games by publisher "<%= publisher %>"
    <% } else if (locals.year) { %>
    Games from <%= year %>
    <% } else if (locals.search) { %>
    Matches for "<%= search %>"
    <% } else { %>
    Games of all genres
    <% } %>
    <small>
      <% if (req.query.orderBy === "title") { %>
      (alphabetical)
      <% } else if (req.query.orderBy === "createdAt") { %>
      (recently added)
      <% } else if (req.query.orderBy === "release") { %>
      (by release years)
      <% } else if (req.query.orderBy === "rating") { %>
      (by rating)
      <% } %>
    </small>
  </h2>
  <%
    // Re-sorting keeps the rest of the query, and only drops the page.
    //
    // These four wrote a bare "?orderBy=…&orderDir=…", which threw away
    // everything else the address carried — most visibly `search`, so sorting
    // a set of results silently replaced it with the whole unfiltered
    // catalogue. The two arrows below already spread req.query for exactly
    // this reason; this is the same thing, with `page` dropped because a new
    // sort re-orders the whole list and page 7 of the old order means
    // nothing in the new one.
    const sortHref = (orderBy, orderDir) => {
      const params = new URLSearchParams({ ...req.query, orderBy, orderDir });

      params.delete("page");

      return "?" + params.toString();
    };
  %>
  <ul class="sorting-options">
    <li>
      <a class="<%= req.query.orderBy === 'title' ? 'active' : '' %>" href="<%= sortHref('title', 'ASC') %>">A-Z</a>
    </li>
    <li>
      <a class="<%= req.query.orderBy === 'createdAt' ? 'active' : '' %>" href="<%= sortHref('createdAt', 'DESC') %>">New</a>
    </li>
    <li>
      <a class="<%= req.query.orderBy === 'release' ? 'active' : '' %>" href="<%= sortHref('release', 'ASC') %>">Year</a>
    </li>
    <li>
      <a class="<%= req.query.orderBy === 'rating' ? 'active' : '' %>" href="<%= sortHref('rating', 'DESC') %>">Rating</a>
    </li>
    <li class="separator">|</li>
    <li>
      <a aria-label="Order by ASC" class="inline-block hover-scale <%= req.query.orderDir === 'ASC' || (!req.query.orderDir && (locals.letter || locals.year || locals.developer || locals.publisher)) ? 'active' : '' %>" href="?<%= new URLSearchParams({ ...req.query, orderDir: 'ASC' }).toString() %>" title="Order by ASC" style="margin: -2px -3px">
        ▲
      </a>
    </li>
    <li>
      <a aria-label="Order by DESC" class="inline-block hover-scale <%= req.query.orderDir === 'DESC' || (!req.query.orderDir && !(locals.letter || locals.year || locals.developer || locals.publisher)) ? 'active' : '' %>" href="?<%= new URLSearchParams({ ...req.query, orderDir: 'DESC' }).toString() %>" title="Order by DESC" style="margin: -2px -3px">
        ▼
      </a>
    </li>
  </ul>
</div>
