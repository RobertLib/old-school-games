<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../head') %>
  <% if (game.cover) { %>
  <!-- The cover, fetched as early as the preload scanner can see it.
       .game-hero-background sets it as an inline `background-image`, and a
       background is discovered only once the stylesheet has been fetched,
       parsed and matched against the element — so the largest thing on the
       page started downloading a full round trip after everything else did.
       That block is full-width and 260px tall (see .game-hero in style.css),
       which on most viewports makes it the LCP element.

       One hint covers two uses: the <img> further down the page names the
       same URL, so the fetch this starts is the one both of them read from.
       fetchpriority because the default for a preloaded image is the same
       "low" the rest of the page's artwork gets, and the point here is that
       this one is not like the rest. -->
  <link rel="preload" as="image" href="<%= game.cover %>" fetchpriority="high" />
  <% } %>
  <meta name="description" content="<%= locals.description || siteDescription %>" />
  <title><%= locals.title || siteTitle %></title>
  <!-- Open Graph -->
  <meta property="og:title" content="<%= locals.title || siteTitle %>" />
  <meta property="og:description" content="<%= locals.description || siteDescription %>" />
  <%- include('../og-image') %>
  <meta property="og:url" content="<%= locals.ogUrl || locals.canonicalUrl || (siteUrl + req.path) %>" />
  <meta property="og:type" content="video.game" />
  <meta property="og:site_name" content="<%= siteName %>" />
  <script defer src="<%= asset('/js/rating-stars.js') %>"></script>
  <%
    // Only on a page that asks to be indexed. views/head.ejs already gates the
    // robots tag, the canonical and the breadcrumb schema on this one answer;
    // a node describing the page in detail belongs on the same side of it.
    // Nothing here was ever wrong — it was sent to consumers that had just
    // been told the page is not for them. See utils/indexability.ts.
  %>
  <% if (!isNoindex(req, locals)) { %>
  <script type="application/ld+json"><%- JSON.stringify(locals.ldJson).replace(/</g, "\\u003c") %></script>
  <% } %>
  <script nonce="<%= cspNonce %>">
    document.addEventListener('keydown', function(event) {
      if (event.altKey && event.key === 'Enter') {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        const iframe = document.querySelector('.game-detail-stream');
        if (iframe) {
          // The player is same-origin, so the message is addressed to this
          // origin rather than broadcast to whatever happens to be framed.
          iframe.contentWindow.postMessage({ action: 'clickFullscreen' }, window.location.origin);
        }
      }
    });
  </script>
</head>

<body class="layout">
  <%- include('../navbar') %>
  <%- include('../left-sidebar') %>
  <main>
    <div class="container">
      <%- include('../breadcrumb') %>
      <section>
        <header class="game-detail-header">
          <div class="flex align-center justify-between" style="gap: 15px; width: 100%">
            <%
              // Deliberately a real link, not history.back(): most visitors
              // arrive from a search engine, where "back" would send them
              // straight off the site.
              const backHref = game.genre ? `/${game.genre.toLowerCase()}` : "/";
              const backLabel = game.genre
                ? `All ${game.genre.charAt(0) + game.genre.slice(1).toLowerCase()} games`
                : "All games";
            %>
            <a class="align-center color-primary inline-flex" href="<%= backHref %>" style="gap: 7px">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" width="15" height="17">
                <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
              </svg>
              <%= backLabel %>
            </a>
            <nav class="game-nav flex align-center" style="gap: 10px">
              <% if (locals.prevGame) { %>
              <a class="btn btn-outline btn-sm" href="/<%= prevGame.slug %>" title="<%= prevGame.title %>">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" fill="currentColor" width="10" height="12">
                  <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l192 192c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L77.3 256 246.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-192 192z" />
                </svg>
                Prev
              </a>
              <% } %>
              <% if (locals.nextGame) { %>
              <a class="btn btn-outline btn-sm" href="/<%= nextGame.slug %>" title="<%= nextGame.title %>">
                Next
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" fill="currentColor" width="10" height="12">
                  <path d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z" />
                </svg>
              </a>
              <% } %>
            </nav>
          </div>
          <% if (req.session?.user?.role === "ADMIN") { %>
          <div class="flex align-center nowrap" style="gap: 5px">
            <a class="btn btn-outline btn-sm" href="/games/<%= game.id %>/edit">
              Edit
            </a>
            <form action="/games/<%= game.id %>/delete" method="POST" data-confirm="Are you sure?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn btn-outline btn-sm" type="submit">
                Delete
              </button>
            </form>
          </div>
          <% } %>
        </header>
        <div>
          <div class="game-hero">
            <% if (game.cover) { %>
            <div class="game-hero-background" style="background-image: url('<%= game.cover %>')"></div>
            <% } %>
            <div class="game-hero-content">
              <div>
                <h1 class="game-hero-title"><%= game.title %></h1>
                <p class="game-hero-meta">
                  <span class="badge"><%= game.genre %></span>
                  <span class="badge"><%= game.release %></span>
                </p>
              </div>
              <% if (game.stream) { %>
              <a class="btn btn-primary game-hero-play" href="#just-play-it">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" fill="currentColor" width="14" height="16">
                  <path d="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80L0 432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z" />
                </svg>
                Play now
              </a>
              <% } %>
            </div>
          </div>
          <header>
            <div class="description">
              <div class="description-content clearfix" id="game-description">
                <% if (game.cover) { %>
                <!-- Not lazy: it sits directly beneath the 260px hero, so on an
                     ordinary viewport it is within the first screen — and a
                     lazy image inside the initial viewport is simply one the
                     browser was told to wait for before fetching. It is also
                     the same file the hero preloads, so eager here costs no
                     second request. -->
                <img alt="<%= game.title %> – MS-DOS cover art" class="game-detail-initial" height="191" loading="eager" src="<%= game.cover %>" width="150" />
                <% } %>
                <%- game.description %>
              </div>
              <div class="text-right">
                <button class="more-btn btn btn-sm" style="margin-top: 10px" type="button" aria-controls="game-description" aria-expanded="false">
                  more...
                </button>
              </div>
            </div>
          </header>
          <div class="text-sm" style="margin-bottom: 20px">
            <hr />
            <strong>Genre</strong>:
            <% if (game.genre) { %>
            <a class="underline color-primary" href="/<%= game.genre.toLowerCase() %>"><%= game.genre %></a>
            <% } else { %>
            -
            <% } %><br />
            <strong>Release</strong>:
            <% if (game.release) { %>
            <a class="underline color-primary" href="/year/<%= game.release %>"><%= game.release %></a>
            <% } else { %>
            -
            <% } %><br />
            <strong>Developer</strong>:
            <% if (game.developer) { %>
            <a class="underline" href="/developer/<%= encodeURIComponent(game.developer) %>"><%= game.developer %></a>
            <% } else { %>
            -
            <% } %><br />
            <strong>Publisher</strong>:
            <% if (game.publisher) { %>
            <a class="underline" href="/publisher/<%= encodeURIComponent(game.publisher) %>"><%= game.publisher %></a>
            <% } else { %>
            -
            <% } %><br />
            <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: baseline">
              <rating-stars gameId="<%= game.id %>" rating="<%= game.averageRating %>" ratingCount="<%= game.ratingCount || 0 %>" userRating="<%= locals.userRating || '' %>">
              </rating-stars>
              <button aria-label="Add <%= game.title %> to favorites" class="favorite-btn" data-game-id="<%= game.id %>" title="Favorite" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
              </button>
            </div>
            <hr />
          </div>
        </div>
      </section>
      <% if (game.stream) { %>
      <section id="just-play-it">
        <h2 style="margin-bottom: 10px">Just play it!</h2>
        <div class="text-sm" style="margin-bottom: 15px; padding: 10px; border-radius: var(--border-radius); border-left: 3px solid rgb(var(--primary-rgb));">
          <strong>Tip:</strong> Press <kbd class="btn btn-sm" style="font-size: 0.8em; padding: 2px 6px; margin: 0 2px">Alt + Enter</kbd> to toggle fullscreen mode
        </div>
        <details style="margin-bottom: 15px; padding: 10px; background: var(--panel-tint); border: 1px solid rgb(var(--border-rgb) / 0.5); border-radius: var(--border-radius);">
          <summary class="text-sm" style="cursor: pointer; color: rgb(var(--accent-rgb)); user-select: none">
            Quick tips — new to MS-DOS games?
          </summary>
          <div class="text-sm" style="margin-top: 10px; line-height: 1.8">
            <ul style="padding-left: 18px; margin: 0 0 8px">
              <li><strong>Click inside the game</strong> to give it keyboard/mouse focus.</li>
              <li><kbd>Ctrl + F10</kbd> — release or re-capture the mouse cursor.</li>
              <li>Saving varies by game — look for <em>Save</em> in the in-game menu (<kbd>Esc</kbd> or <kbd>F1</kbd>), or try <kbd>F5</kbd> / <kbd>F7</kbd>.</li>
              <li>Some games use <strong>passwords</strong> instead of saves — note it down!</li>
              <li>Controls are often shown on the game's intro or title screen — don't skip them.</li>
              <li>🖥️ <strong>CRT filter</strong> is on by default for that authentic monitor look. Toggle it with <kbd class="btn btn-sm" style="font-size: 0.8em; padding: 2px 6px; margin: 0 2px">Alt+F7</kbd> or the <strong>CRT: ON/OFF</strong> button in the bottom-right corner of the game. Your preference is remembered.</li>
            </ul>
            <a class="color-primary underline" href="/how-to-play">Full guide: How to Play MS-DOS Games →</a>
          </div>
        </details>
        <div class="touch-only game-touch-notice">
          <strong>Playing on a phone or tablet?</strong>
          MS-DOS games were built for a physical keyboard. Use the
          <strong>keyboard button in the game's bottom bar</strong> to bring up
          the on-screen keys, or connect a Bluetooth keyboard — some games are
          hard to control by touch alone.
        </div>
        <!--
          asset() so the frame's own content hash rides in the address, the
          way it does for every script and stylesheet on the page.

          The frame is a static file, so the hash is not what makes a change
          reach a browser here — app.ts serves it "no-cache" for that. It is
          what reaches a browser holding a copy stored before that header
          existed, which is a different problem and one nothing else solves:
          such a copy is fresh for a day by its own terms, and the browser
          never asks about it. It also carries the Content-Security-Policy of
          the deploy it came from, so a day-old frame refused the emulator
          the current player asks for and started no game at all — on exactly
          the games that had been opened before, and no others.

          Changing the address retires every one of those at once.

          encodeURIComponent, or a bundle URL containing "&" or "#" loses
          everything after it.
        -->
        <% const playerFrame = asset('/js-dos.html'); %>
        <% const playerSrc = playerFrame + (playerFrame.includes('?') ? '&' : '?') + 'stream=' + encodeURIComponent(game.stream); %>
        <!--
          Click to play, not autoplay.

          The emulator used to boot the moment the page loaded, and the play
          was counted — and the game added to "Continue playing" — on the
          frame's load event. So a visitor who arrived from a search, read
          the description and left had "played" the game: the Most Played
          ranking was a page-view ranking, the wasm and the bundle were
          fetched on every visit, and the recently-played list filled with
          games nobody had run.

          The frame is now created by public/js/game-player.js when the
          poster is clicked, and that click is what records the play. The
          poster is the cover, so the box looks like the game it starts.
          Without JavaScript the frame is there as before.
        -->
        <div class="game-detail-player" data-game-id="<%= game.id %>" data-player-src="<%= playerSrc %>" data-title="<%= game.title %>">
          <button class="game-detail-poster" type="button"<% if (game.cover) { %> style="background-image: url('<%= game.cover %>')"<% } %>>
            <span class="game-detail-poster-label">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" fill="currentColor" width="14" height="16" aria-hidden="true">
                <path d="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80L0 432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z" />
              </svg>
              Click to play <%= game.title %>
            </span>
          </button>
          <noscript>
            <iframe class="game-detail-stream" src="<%= playerSrc %>" style="border: 0" title="<%= game.title %>"></iframe>
          </noscript>
        </div>
        <script defer src="<%= asset('/js/game-player.js') %>"></script>
      </section>
      <% } %>
      <div style="margin: 25px 0 15px">
        <% game.images.filter(Boolean).forEach((image, index) => { %>
        <% if (index !== 0) { %>
        <figure class="inline-block" style="margin: 0">
          <a href="/<%= game.slug %>/gallery/<%= index %>" style="cursor: pointer;">
            <img src="<%= image %>" alt="<%= game.title %> – screenshot <%= index %>" width="320" height="200" loading="lazy" />
          </a>
        </figure>
        <% } %>
        <% }); %>
      </div>
      <div class="flex" style="gap: 10px">
        <div class="flex-1">
          <% if (game.manual) { %>
          <p>
            <a class="color-primary" href="<%= game.manual %>" target="_blank" rel="noopener noreferrer">
              Manual
            </a>
          </p>
          <% } %>
        </div>
        <nav style="margin: 15px 0">
          Share on social media:
          <a class="color-primary underline" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(locals.ogUrl || locals.canonicalUrl || (siteUrl + req.path)) %>" target="_blank" rel="noopener noreferrer">
            Facebook
          </a>
          |
          <a class="color-primary underline" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(locals.ogUrl || locals.canonicalUrl || (siteUrl + req.path)) %>&text=<%= encodeURIComponent(game.title) %>" target="_blank" rel="noopener noreferrer">
            Twitter
          </a>
        </nav>
      </div>

      <!-- Related Links Section -->
      <section style="margin: 25px 0; padding: 20px; background: var(--panel-tint); border: 1px solid rgb(var(--border-rgb)); border-radius: var(--border-radius);">
        <h3 style="margin: 0 0 15px; color: rgb(var(--primary-rgb)); text-shadow: var(--text-shadow);">Explore More</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; color: rgb(var(--color-rgb));">
          <% if (game.genre) { %>
          <div>
            <strong style="color: rgb(var(--accent-rgb));">More <%= game.genre.charAt(0) + game.genre.slice(1).toLowerCase() %> Games:</strong>
            <br>
            <a href="/<%= game.genre.toLowerCase() %>" class="color-primary underline">
              Browse all <%= game.genre.toLowerCase() %> games
            </a>
          </div>
          <% } %>

          <% if (game.release) { %>
          <div>
            <strong style="color: rgb(var(--accent-rgb));">Games from <%= game.release %>:</strong>
            <br>
            <a href="/year/<%= game.release %>" class="color-primary underline">
              See all games from <%= game.release %>
            </a>
          </div>
          <% } %>

          <% if (game.developer) { %>
          <div>
            <strong style="color: rgb(var(--accent-rgb));">Developer:</strong>
            <br>
            <a href="/developer/<%= encodeURIComponent(game.developer) %>" class="color-primary underline">
              More games by <%= game.developer %>
            </a>
          </div>
          <% } %>

          <% if (game.publisher && game.publisher !== game.developer) { %>
          <div>
            <strong style="color: rgb(var(--accent-rgb));">Publisher:</strong>
            <br>
            <a href="/publisher/<%= encodeURIComponent(game.publisher) %>" class="color-primary underline">
              Games published by <%= game.publisher %>
            </a>
          </div>
          <% } %>
        </div>
      </section>

      <%- include('similar-games') %>
      <section id="comments">
        <h2>
          Comments
          <% if (locals.commentCount) { %>
          <span class="comment-count">(<%= commentCount %>)</span>
          <% } %>
        </h2>
        <%- include('../comments/comment-list') %>
        <h2>New Comment</h2>
        <%- include('../flash') %>
        <%- include('../comments/comment-form') %>
      </section>
    </div>
  </main>
  <%- include('../right-sidebar') %>
  <%- include('../footer') %>
</body>

</html>
