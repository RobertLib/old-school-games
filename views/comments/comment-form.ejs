<form id="comment-form">
  <input name="gameId" type="hidden" value="<%= game.id %>" />
  <input id="comment-parent-id" name="parentId" type="hidden" value="" />

  <p class="comment-reply-context" hidden id="comment-reply-context">
    Replying to <strong id="comment-reply-target"></strong>
    <button class="comment-cancel-reply" id="comment-cancel-reply" type="button">Cancel</button>
  </p>

  <p>
    <label class="form-label" for="nick">Nick</label><br />
    <input class="form-control" id="nick" maxlength="255" name="nick" type="text" />
  </p>
  <p>
    <label class="form-label" for="content">Content *</label><br />
    <textarea class="form-control" id="content" maxlength="1000" name="content" required rows="10"></textarea>
  </p>
  <button class="btn" id="comment-submit" type="submit">Post comment</button>
  <p class="alert error" hidden id="comment-error" role="alert"></p>
  <p aria-live="polite" class="visually-hidden" id="comment-status"></p>
  <br /><br />
</form>
<!-- Deferred like every other script the site loads. Safe here because
     game-detail.ejs includes comment-list.ejs above this partial, so
     "#comment-list" — the one element this script reaches for outside the
     form — is already parsed either way; all `defer` changes is that the
     rest of the page (the sidebars, the footer) no longer waits for it. -->
<script defer src="<%= asset('/js/comments.js') %>"></script>
