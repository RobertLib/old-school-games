<!DOCTYPE html>
<html lang="en">

<head>
  <%# The status the caller answered with, which is not always 400:
      routes/comments.ts renders this page for every refusal of a comment
      posted without JavaScript — a 404 for a game that has gone, a 409 for a
      reply to a removed comment, a 429 from the limiter — and all of them
      used to be headed "400 — Bad request". %>
  <% const status = [404, 409, 429].includes(locals.status) ? locals.status : 400 %>
  <% const heading = { 400: 'Bad request', 404: 'Not found', 409: 'Conflict', 429: 'Too many requests' }[status] %>
  <%# Declared above the include, not below it: head.ejs writes the Twitter
     card from these two and a const declared after it is not in scope there.
     See the twitter:title comment in views/head.ejs. %>
  <% const title = `${status} - ${heading.replace(/\b\w/g, (c) => c.toUpperCase())} - OldSchoolGames` %>
  <% const description = 'That request could not be processed. Go back and try again, or explore our collection of classic MS-DOS games.' %>
  <%- include('head', { title, description }) %>
  <title><%= title %></title>
  <meta name="description" content="<%= description %>" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= description %>" />
  <%# No og:url here, nor on the other three error views. Each of them named
      the site's address with its own status code on the end, and not one of
      those is an address on this site — nothing routes them, so a consumer
      that followed the tag was handed this same error page again.

      There is no honest value to put in its place. og:url is the canonical
      address of the thing being shared, and the thing being shared here is a
      failure: the address that was actually asked for is the one that does not
      work, and publishing it as canonical would be worse than saying nothing.
      With the tag gone a consumer falls back to the link it was given, which
      is the truth. The rest of the Open Graph block stays, so a shared link
      still gets a title, a description and a picture. %>
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= siteName %>" />
  <%# Handed the title as head.ejs is — see the same line in views/404.ejs. %>
  <%- include('og-image', { title }) %>
</head>

<body class="layout">
  <%- include('navbar') %>
  <%- include('left-sidebar') %>
  <main id="main" tabindex="-1">
    <div class="container">
      <h1 class="text-xl" style="margin: 0 0 10px"><%= status %> &mdash; <%= heading %></h1>
      <% if (locals.message) { %>
      <%# The message's own full stop, if it has one, is the one that ends the
          sentence: "…please try again later." came out with a second one
          after it. And a message that already says to try again is not told
          so twice. %>
      <% const said = String(message).replace(/[.!?]+$/, '') %>
      <p style="margin: 0 0 5px"><%= said %>.<% if (!/try again/i.test(said)) { %> Go back and try again.<% } %></p>
      <% } else { %>
      <p style="margin: 0 0 5px">
        That request could not be processed &mdash; it may have been malformed,
        or too large to send. Go back and try again.
      </p>
      <% } %>
      <%- include('error-nav') %>
    </div>
  </main>
  <%- include('right-sidebar') %>
  <%- include('footer') %>
</body>

</html>
