# The "engines" field in package.json is a statement, not a suggestion.
#
# Without this npm prints a warning and installs anyway, so a checkout on the
# wrong major gets a full node_modules and finds out later — and "later" here
# means something specific: the app is started as `node index.ts` and relies
# on the runtime stripping the type annotations, which no Node before 22.18
# does at all. The failure that reaches a person is then a syntax error in a
# file that is perfectly valid.
#
# Node 24 is the one version this project is built and tested against, and it
# is written down in four places that have to move together: .nvmrc, the
# "engines" range, ARG NODE_VERSION in the Dockerfile and NODE_VERSION in
# fly.toml. `nvm use` reads the first of them.
engine-strict=true
