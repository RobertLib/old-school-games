{
  "name": "old-school-games",
  "version": "1.0.0",
  "description": "Browse and play classic MS-DOS games directly in the browser.",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "node --watch --env-file-if-exists=.env index.ts",
    "start": "node --env-file-if-exists=.env index.ts",
    "migrate": "node --env-file-if-exists=.env migrate.ts",
    "create-admin": "node --env-file-if-exists=.env create-admin.ts",
    "format:ejs": "find views -name '*.ejs' -exec npx js-beautify --type html --indent-size 2 --end-with-newline --content_unformatted 'script' -r {} \\;"
  },
  "keywords": [
    "ms-dos",
    "dos-games",
    "retro-gaming",
    "js-dos",
    "dosbox",
    "express",
    "postgresql"
  ],
  "author": "Robert Libsansky",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "dompurify": "^3.3.3",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "jsdom": "^30.0.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "js-beautify": "^2.0.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
