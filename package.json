{
  "name": "old-school-games",
  "version": "1.0.0",
  "private": true,
  "description": "Browse and play classic MS-DOS games directly in the browser.",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertLib/old-school-games.git"
  },
  "homepage": "https://oldschoolgames.eu",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "node --watch --env-file-if-exists=.env index.ts",
    "start": "node --env-file-if-exists=.env index.ts",
    "migrate": "node --env-file-if-exists=.env migrate.ts",
    "create-admin": "node --env-file-if-exists=.env create-admin.ts",
    "backup:media": "bash scripts/backup-media.sh",
    "format:ejs": "find views -name '*.ejs' -exec npx js-beautify --type html --indent-size 2 --end-with-newline --content_unformatted 'script' -r {} \\;"
  },
  "keywords": [
    "ms-dos",
    "dos-games",
    "retro-gaming",
    "js-dos",
    "dosbox",
    "express",
    "postgresql"
  ],
  "author": "Robert Libsansky",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dompurify": "^3.4.16",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "js-dos": "8.4.1",
    "jsdom": "^30.1.1",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "js-beautify": "^2.0.3",
    "supertest": "^7.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "overrides": {
    "@typescript/old": "npm:typescript@>=6.0.3 <6.1.0"
  }
}
